// WRITE FILES

// datatype: FILE, nomi: p+nomefile, ex: pFile

#include <stdio.h>

int main (){

  FILE *pFile = fopen("output.txt", "w");    // fopen stands for: file open
                                             // 1st argument: name file
                                             // 2nd argument: "w" write mode, "r" read mode

  if(pFile == NULL){    // controllo se ho creato con successo il file

    printf("Error opening file\n");

    return 1;
  }

  fclose(pFile);    // chiude file, sempre se apri, dentro: nome file reference

  return 0;
}
  
char text[] = "NEVER GONNA GIVE YOU UP\nNEVER GONNA LET YOU DOWN!";

fprintf(pFile, "%s", text);    // fprintf, ossia file printf, %s significa string
  























