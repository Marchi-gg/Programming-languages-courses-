// MALLOC


// stands for memory allocation,
// alloca dinamicamente uno specifico numero di byte in memoria
// necessita di #include <stdlib.h>

int number = 0;

printf("Enter the number of grades: ");    // es, 6 voti

scanf("%d", &number);

char* grades = malloc(number * sizeof(char));    // sizeof(char) == dimensioni di char, 1 byte, 6*1
                                                 // sizeof(int) == dimensioni int, 4 byte, 6*4
                                                 // affittiamo parte di memoria dallo heap
                                                 // (di solito la memoria viene dallo stack)
                                                 // malloc returns a pointer to where that memory
                                                 // is located that we reserved

if(grades == NULL){    // controllo per verificare di non star direferenziando un puntatore NULL
                       // segmentation fault: trying to access to a memory location not allowed

  printf("Memory allocation failed!\n");

  return 1;    // 1 funziona come exit code, vuol dire che c'è un problema
}

for (int i = 0; i < number; i++){    // per quanti numeri metterà l'utente

  printf("Enter grade #%d: ", i + 1);    // prompt

  scanf(" %c", &grades[i]);    // %c sta per char
}

for (int i = 0; i < number; i++){

  printf("%c ", grades[i]);    // stampo ogni voto
}

free(grades);    // returning the "rented" space back to the OS

grades = NULL;    // avoids "dangling" (penzolanti) pointers


